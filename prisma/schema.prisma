datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ShopSession {
  id          Int      @id @default(autoincrement())
  shop        String   @unique
  accessToken String
  scope       String?
  isOnline    Boolean  @default(false)
  adminHost   String?           // <-- nuevo: el campo que faltaba
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model TryOnLog {
  id          Int      @id @default(autoincrement())
  shop        String
  productId   String
  externalId  String?
  variantId   String?
  customerId  String?
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([shop, productId])
}
model TryOnSelection {
  id           Int      @id @default(autoincrement())
  shop         String
  productsJson String
  createdAt    DateTime @default(now())

  @@map("tryOnSelection")
}
