datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets = ["native", "darwin-arm64", "debian-openssl-3.0.x"]
}

model ShopSession {
  id          Int      @id @default(autoincrement())
  shop        String   @unique
  accessToken String
  scope       String?
  isOnline    Boolean  @default(false)
  adminHost   String?           // <-- nuevo: el campo que faltaba
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model TryOnLog {
  id          Int      @id @default(autoincrement())
  shop        String
  productId   String
  externalId  String?
  variantId   String?
  customerId  String?
  action      String
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([shop, productId])
}
model TryOnSelection {
  id           Int      @id @default(autoincrement())
  shop         String
  productsJson String
  createdAt    DateTime @default(now())

  @@map("tryOnSelection")

}

model User {
  id           String    @id @default(cuid())
  firstName    String?
  lastName     String?
  email        String    @unique
  whatsapp     String?
  passwordHash String?
  image        String?
  name         String?
  emailVerified DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  accounts     Account[]
  sessions     Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
